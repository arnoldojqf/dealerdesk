{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(make:*)",
      "Bash(python3 tests/golden.py)",
      "Bash(python3 tests/golden.py --selfcheck)",
      "Bash(python3 scripts/check-agent-setup.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git remote -v)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ls:*)",
      "Bash(grep:*)"
    ],
    "ask": [
      "Bash(python3 tests/golden.py --update:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rename:*)",
      "Bash(rm -rf:*)",
      "Edit(data/**)",
      "Write(data/**)",
      "Edit(tests/golden/**)",
      "Write(tests/golden/**)",
      "Edit(tests/fixtures/**)",
      "Write(tests/fixtures/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rebuild-on-c-edit.sh"
          }
        ]
      }
    ]
  }
}
